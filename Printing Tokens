#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() {
    char *s;
    s = malloc(1024 * sizeof(char));
    
    // Read the entire line until a newline character is encountered
    if (scanf("%[^\n]%*c", s) != 1) {
        free(s);
        return 0;
    }
    
    // Use strtok to split the string by spaces
    char *token = strtok(s, " ");
    while (token != NULL) {
        printf("%s\n", token);
        token = strtok(NULL, " ");
    }
    
    free(s);
    return 0;
}
