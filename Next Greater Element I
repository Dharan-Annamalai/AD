#include <stdio.h>
#include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* nextGreaterElement(int* nums1, int nums1Size, int* nums2, int nums2Size, int* returnSize) {
    // Allocate memory for the result array
    int* ans = (int*)malloc(nums1Size * sizeof(int));
    *returnSize = nums1Size;

    // Direct-address table to map an element to its next greater element
    // Initialised to -1 to easily handle elements with no greater neighbor
    int next_greater[10001];
    for (int i = 0; i <= 10000; i++) {
        next_greater[i] = -1;
    }

    // Monotonic stack implementation
    int* stack = (int*)malloc(nums2Size * sizeof(int));
    int top = -1;

    // Process nums2 to find the next greater element for each number
    for (int i = 0; i < nums2Size; i++) {
        // While stack is not empty and current element is greater than stack's top
        while (top != -1 && nums2[i] > stack[top]) {
            next_greater[stack[top]] = nums2[i];
            top--; // Pop
        }
        // Push current element onto the stack
        stack[++top] = nums2[i];
    }

    // Free the dynamically allocated stack memory
    free(stack);

    // Map the results back to nums1
    for (int i = 0; i < nums1Size; i++) {
        ans[i] = next_greater[nums1[i]];
    }

    return ans;
}
