int removeDuplicates(int* nums, int numsSize) {
    // If the array has 2 or fewer elements, every element is automatically valid
    if (numsSize <= 2) {
        return numsSize;
    }
    
    // 'index' tracks where the next valid element should be written
    int index = 2; 
    
    // Loop through the array starting from the third element
    for (int i = 2; i < numsSize; i++) {
        // Compare the current element with the element two positions back in our valid subarray
        if (nums[i] != nums[index - 2]) {
            nums[index] = nums[i];
            index++;
        }
    }
    
    // 'index' represents the count of valid elements ('k')
    return index;
}
