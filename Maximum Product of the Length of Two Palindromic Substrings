#include <stdio.h>
#include <stdlib.h>
#include <string.h>
long long maxProduct(char* s) {
    int n = strlen(s);
    if (n < 2) return 0;
    int* p = (int*)calloc(n, sizeof(int));
    int c = 0, r = 0;
    for (int i = 0; i < n; i++) {
        int mirror = 2 * c - i;
        if (i < r) {
            p[i] = (r - i < p[mirror]) ? (r - i) : p[mirror];
        }
        while (i - 1 - p[i] >= 0 && i + 1 + p[i] < n && s[i - 1 - p[i]] == s[i + 1 + p[i]]) {
            p[i]++;
        }
        if (i + p[i] > r) {
            c = i;
            r = i + p[i];
        }
    }
    int* left = (int*)malloc(n * sizeof(int));
    int* right = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        left[i] = 1;
        right[i] = 1;
    }
    for (int i = 0; i < n; i++) {
        int len_pal = 2 * p[i] + 1;
        
        int end_idx = i + p[i];
        if (len_pal > left[end_idx]) {
            left[end_idx] = len_pal;
        }

        int start_idx = i - p[i];
        if (len_pal > right[start_idx]) {
            right[start_idx] = len_pal;
        }
    }
    for (int i = n - 1; i > 0; i--) {
        if (left[i] - 2 > left[i - 1]) {
            left[i - 1] = left[i] - 2;
        }
    }
    for (int i = 1; i < n; i++) {
        if (left[i - 1] > left[i]) {
            left[i] = left[i - 1];
        }
    }
    for (int i = 0; i < n - 1; i++) {
        if (right[i] - 2 > right[i + 1]) {
            right[i + 1] = right[i] - 2;
        }
    }
    for (int i = n - 2; i >= 0; i--) {
        if (right[i + 1] > right[i]) {
            right[i] = right[i + 1];
        }
    }
    long long max_prod = 0;
    for (int i = 0; i < n - 1; i++) {
        long long prod = (long long)left[i] * (long long)right[i + 1];
        if (prod > max_prod) {
            max_prod = prod;
        }
    }
    free(p);
    free(left);
    free(right);
    return max_prod;
}
