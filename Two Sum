#include <stdlib.h>
#include <math.h>

typedef struct {
    int key;
    int value;
} HashEntry;

int* twoSum(int* nums, int numsSize, int target, int* returnSize) {
    *returnSize = 2;
    int* result = (int*)malloc(2 * sizeof(int));
    
    // Set hash table size larger than numsSize to reduce collisions
    int mapSize = numsSize * 2;
    HashEntry* hashTable = (HashEntry*)calloc(mapSize, sizeof(HashEntry));
    int* used = (int*)calloc(mapSize, sizeof(int));

    for (int i = 0; i < numsSize; i++) {
        int complement = target - nums[i];
        
        // Look up the complement in the hash table
        int hash = abs(complement) % mapSize;
        while (used[hash]) {
            if (hashTable[hash].key == complement) {
                result[0] = hashTable[hash].value;
                result[1] = i;
                free(hashTable);
                free(used);
                return result;
            }
            hash = (hash + 1) % mapSize;
        }
        
        // Insert the current number and its index into the hash table
        hash = abs(nums[i]) % mapSize;
        while (used[hash]) {
            hash = (hash + 1) % mapSize;
        }
        hashTable[hash].key = nums[i];
        hashTable[hash].value = i;
        used[hash] = 1;
    }
    
    // Clean up memory if no solution is found (though the problem guarantees one)
    free(hashTable);
    free(used);
    return result;
}
