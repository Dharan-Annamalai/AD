#include <stdio.h>

// Macro to find the maximum of two numbers
#define MAX(a, b) ((a) > (b) ? (a) : (b))

int jump(int* nums, int numsSize) {
    // If the array has only 1 element, we are already at the destination
    if (numsSize <= 1) {
        return 0;
    }

    int jumps = 0;
    int current_end = 0;
    int farthest = 0;

    // Loop through the array up to numsSize - 2
    for (int i = 0; i < numsSize - 1; i++) {
        // Track the absolute farthest index we can reach from here
        farthest = MAX(farthest, i + nums[i]);

        // If we have reached the end of our current jump range window
        if (i == current_end) {
            jumps++;                // We must make a jump
            current_end = farthest; // Update our window to the new farthest reach
            
            // Optimization: If our new window already reaches or passes the last index,
            // we can stop early!
            if (current_end >= numsSize - 1) {
                break;
            }
        }
    }

    return jumps;
}
