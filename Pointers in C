#include <stdio.h>
void update(int *a, int *b) {
    int temp_a = *a;
    int temp_b = *b;
    *a = temp_a + temp_b;
    *b = (temp_a > temp_b) ? (temp_a - temp_b) : (temp_b - temp_a);
}
int main() {
    int x, y;
    if (scanf("%d %d", &x, &y) == 2) {
        update(&x, &y);
        printf("%d\n%d\n", x, y);
    }
    return 0;
}
