/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 */

struct ListNode* rotateRight(struct ListNode* head, int k) {
    // Base case: if the list is empty, has 1 node, or no rotation is needed
    if (!head || !head->next || k == 0) {
        return head;
    }
    
    // Step 1: Calculate the length of the list and find the tail node
    struct ListNode* tail = head;
    int length = 1;
    while (tail->next) {
        tail = tail->next;
        length++;
    }
    
    // Step 2: Handle cases where k >= length
    k = k % length;
    if (k == 0) {
        return head; 
    }
    
    // Step 3: Link tail to head to form a circular list
    tail->next = head;
    
    // Step 4: Find the new tail node (at position length - k)
    int stepsToNewTail = length - k;
    struct ListNode* newTail = head;
    for (int i = 1; i < stepsToNewTail; i++) {
        newTail = newTail->next;
    }
    
    // Step 5: Break the circle and update the head
    struct ListNode* newHead = newTail->next;
    newTail->next = NULL;
    
    return newHead;
}
