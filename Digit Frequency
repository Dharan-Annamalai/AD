#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() {
    // Allocate memory for a string up to 1000 characters
    char *s = malloc(1025 * sizeof(char));
    if (scanf("%s", s) != 1) {
        free(s);
        return 0;
    }
    
    // Initialize frequency array for digits 0-9 with zeros
    int freq[10] = {0};
    
    // Iterate through the string character by character
    for (int i = 0; s[i] != '\0'; i++) {
        if (s[i] >= '0' && s[i] <= '9') {
            freq[s[i] - '0']++;
        }
    }
    
    // Print the frequencies separated by spaces
    for (int i = 0; i < 10; i++) {
        printf("%d ", freq[i]);
    }
    printf("\n");
    
    free(s);
    return 0;
}
