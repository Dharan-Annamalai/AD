#include <stdio.h>

int main() {
    // 1. Declare 4 variables: two of type int and two of type float
    int int1, int2;
    float float1, float2;
    
    // 2. Read 2 lines of input from stdin and initialize the variables
    scanf("%d %d", &int1, &int2);
    scanf("%f %f", &float1, &float2);
    
    // 3. Perform operations and print the output according to the format rules
    // First line: sum and difference of the two integers separated by a space
    printf("%d %d\n", int1 + int2, int1 - int2);
    
    // Second line: sum and difference of the two floats rounded to 1 decimal place
    printf("%.1f %.1f\n", float1 + float2, float1 - float2);
    
    return 0;
}
