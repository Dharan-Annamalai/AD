#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int next_permutation(int n, char **s) {
    // Step 1: Find the rightmost string that is lexicographically smaller than its successor
    int i = n - 1;
    while (i > 0 && strcmp(s[i - 1], s[i]) >= 0) {
        i--;
    }
    
    // If no such element is found, we are on the absolute last permutation
    if (i <= 0) {
        return 0;
    }
    
    // Step 2: Find the rightmost string in the suffix that is greater than s[i - 1]
    int j = n - 1;
    while (strcmp(s[j], s[i - 1]) <= 0) {
        j--;
    }
    
    // Step 3: Swap elements at index (i - 1) and j
    char *temp = s[i - 1];
    s[i - 1] = s[j];
    s[j] = temp;
    
    // Step 4: Reverse the suffix from index i to the end of the array
    j = n - 1;
    while (i < j) {
        temp = s[i];
        s[i] = s[j];
        s[j] = temp;
        i++;
        j--;
    }
    
    return 1;
}


int main()
{
	char **s;
	int n;
	scanf("%d", &n);
	s = calloc(n, sizeof(char*));
	for (int i = 0; i < n; i++)
	{
		s[i] = calloc(11, sizeof(char));
		scanf("%s", s[i]);
	}
	do
	{
		for (int i = 0; i < n; i++)
			printf("%s%c", s[i], i == n - 1 ? '\n' : ' ');
	} while (next_permutation(n, s));
	for (int i = 0; i < n; i++)
		free(s[i]);
	free(s);
	return 0;
}
