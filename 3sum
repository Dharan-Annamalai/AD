#include <stdio.h>
#include <stdlib.h>

// Comparison function needed for qsort
int compare(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}

/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned as *returnColumnSizes array.
 * Note: Both returned arrays and *returnColumnSizes array must be malloced, assume caller calls free().
 */
int** threeSum(int* nums, int numsSize, int* returnSize, int** returnColumnSizes) {
    // 1. Sort the input array
    qsort(nums, numsSize, sizeof(int), compare);
    
    // Estimate a starting capacity for our results array
    int capacity = 16;
    int** result = (int**)malloc(capacity * sizeof(int*));
    *returnColumnSizes = (int*)malloc(capacity * sizeof(int));
    *returnSize = 0;
    
    // 2. Loop through the array, fixing the first number (nums[i])
    for (int i = 0; i < numsSize - 2; i++) {
        // Optimization: If the smallest number is greater than 0, 
        // three positive numbers can never sum to 0.
        if (nums[i] > 0) break;
        
        // Skip duplicate values for the first number
        if (i > 0 && nums[i] == nums[i - 1]) continue;
        
        // Set up two pointers for the remaining part of the array
        int left = i + 1;
        int right = numsSize - 1;
        
        while (left < right) {
            int sum = nums[i] + nums[left] + nums[right];
            
            if (sum == 0) {
                // Resize result array if we run out of space
                if (*returnSize >= capacity) {
                    capacity *= 2;
                    result = (int**)realloc(result, capacity * sizeof(int*));
                    *returnColumnSizes = (int*)realloc(*returnColumnSizes, capacity * sizeof(int));
                }
                
                // Found a valid triplet, allocate memory for it
                result[*returnSize] = (int*)malloc(3 * sizeof(int));
                result[*returnSize][0] = nums[i];
                result[*returnSize][1] = nums[left];
                result[*returnSize][2] = nums[right];
                (*returnColumnSizes)[*returnSize] = 3;
                (*returnSize)++;
                
                // Move pointers and skip duplicates
                while (left < right && nums[left] == nums[left + 1]) left++;
                while (left < right && nums[right] == nums[right - 1]) right--;
                
                left++;
                right--;
            } 
            else if (sum < 0) {
                // Sum is too small, make it bigger by moving the left pointer right
                left++;
            } 
            else {
                // Sum is too big, make it smaller by moving the right pointer left
                right--;
            }
        }
    }
    
    return result;
}
