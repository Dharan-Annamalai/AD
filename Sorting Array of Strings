#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// 1. Sorts the strings in lexicographically non-decreasing order
int lexicographic_sort(const char* a, const char* b) {
    return strcmp(a, b);
}

// 2. Sorts the strings in lexicographically non-increasing order
int lexicographic_sort_reverse(const char* a, const char* b) {
    return strcmp(b, a);
}

// Helper function to count distinct characters in a string
int count_distinct_chars(const char* str) {
    int distinct_count = 0;
    int alphabet_hash[26] = {0};
    
    for (int i = 0; str[i] != '\0'; i++) {
        int index = str[i] - 'a';
        if (alphabet_hash[index] == 0) {
            alphabet_hash[index] = 1;
            distinct_count++;
        }
    }
    return distinct_count;
}

// 3. Sorts strings by number of distinct characters, falling back lexicographically
int sort_by_number_of_distinct_characters(const char* a, const char* b) {
    int distinct_a = count_distinct_chars(a);
    int distinct_b = count_distinct_chars(b);
    
    if (distinct_a == distinct_b) {
        return strcmp(a, b);
    }
    return distinct_a - distinct_b;
}

// 4. Sorts strings by length in non-decreasing order, falling back lexicographically
int sort_by_length(const char* a, const char* b) {
    int len_a = strlen(a);
    int len_b = strlen(b);
    
    if (len_a == len_b) {
        return strcmp(a, b);
    }
    return len_a - len_b;
}

// Generic sorting function using Bubble Sort
void string_sort(char** arr, const int count, int (*cmp_func)(const char* a, const char* b)) {
    for (int i = 0; i < count - 1; i++) {
        for (int j = 0; j < count - i - 1; j++) {
            // Swap if the comparison function determines the order is incorrect (> 0)
            if (cmp_func(arr[j], arr[j + 1]) > 0) {
                char* temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

int main() 
{
    int n;
    scanf("%d", &n);
  
    char** arr;
	arr = (char**)malloc(n * sizeof(char*));
  
    for(int i = 0; i < n; i++){
        *(arr + i) = malloc(1024 * sizeof(char));
        scanf("%s", *(arr + i));
        *(arr + i) = realloc(*(arr + i), strlen(*(arr + i)) + 1);
    }
  
    string_sort(arr, n, lexicographic_sort);
    for(int i = 0; i < n; i++)
        printf("%s\n", arr[i]);
    printf("\n");

    string_sort(arr, n, lexicographic_sort_reverse);
    for(int i = 0; i < n; i++)
        printf("%s\n", arr[i]); 
    printf("\n");

    string_sort(arr, n, sort_by_length);
    for(int i = 0; i < n; i++)
        printf("%s\n", arr[i]);    
    printf("\n");

    string_sort(arr, n, sort_by_number_of_distinct_characters);
    for(int i = 0; i < n; i++)
        printf("%s\n", arr[i]); 
    printf("\n");
}
