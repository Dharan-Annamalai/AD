#include <stdio.h>
#include <stdlib.h>

// Helper comparison function for sorting
int compare(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

// Backtracking function
void backtrack(int* candidates, int candidatesSize, int target, int index, 
               int* current, int currentSize, 
               int*** result, int* resultSize, int** columnSizes) {
    
    // Base Case 1: Target reached!
    if (target == 0) {
        *result = realloc(*result, (*resultSize + 1) * sizeof(int*));
        (*columnSizes) = realloc(*columnSizes, (*resultSize + 1) * sizeof(int));
        
        (*result)[*resultSize] = (int*)malloc(currentSize * sizeof(int));
        for (int i = 0; i < currentSize; i++) {
            (*result)[*resultSize][i] = current[i];
        }
        (*columnSizes)[*resultSize] = currentSize;
        (*resultSize)++;
        return;
    }

    // Loop through the remaining candidates
    for (int i = index; i < candidatesSize; i++) {
        // Optimization: Since the array is sorted, if this number is greater 
        // than our remaining target, no future numbers will work either. Break early!
        if (candidates[i] > target) {
            break;
        }

        // CRITICAL STEP: Skip duplicates at the current level of recursion
        if (i > index && candidates[i] == candidates[i - 1]) {
            continue;
        }

        // Choose the current number
        current[currentSize] = candidates[i];
        
        // Move to the next element (i + 1) because we cannot reuse the same element
        backtrack(candidates, candidatesSize, target - candidates[i], i + 1, 
                  current, currentSize + 1, result, resultSize, columnSizes);
    }
}

// Main function required by LeetCode
int** combinationSum2(int* candidates, int candidatesSize, int target, int* returnSize, int** returnColumnSizes) {
    // 1. Sort the candidates to make grouping duplicates possible
    qsort(candidates, candidatesSize, sizeof(int), compare);

    int** result = NULL;
    int* columnSizes = NULL;
    int resultSize = 0;
    
    // Allocate a path tracker buffer
    int* current = (int*)malloc(candidatesSize * sizeof(int));
    
    // 2. Start backtracking from index 0
    backtrack(candidates, candidatesSize, target, 0, current, 0, &result, &resultSize, &columnSizes);
    
    free(current);
    
    *returnSize = resultSize;
    *returnColumnSizes = columnSizes;
    
    return result;
}
