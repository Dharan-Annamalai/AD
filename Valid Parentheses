#include <stdbool.h>
#include <string.h>
#include <stdlib.h>

bool isValid(char* s) {
    int len = strlen(s);
    
    // Allocate memory for the stack. 
    // In the worst case (all open brackets), the stack will hold all characters.
    char* stack = (char*)malloc(len * sizeof(char));
    int top = -1;
    
    for (int i = 0; i < len; i++) {
        char current = s[i];
        
        // If it's an opening bracket, push it onto the stack
        if (current == '(' || current == '[' || current == '{') {
            stack[++top] = current;
        } 
        // If it's a closing bracket
        else {
            // Stack is empty means there is no matching opening bracket
            if (top == -1) {
                free(stack);
                return false;
            }
            
            char openBracket = stack[top--];
            
            // Check if the closing bracket matches the last opening bracket
            if ((current == ')' && openBracket != '(') ||
                (current == ']' && openBracket != '[') ||
                (current == '}' && openBracket != '{')) {
                free(stack);
                return false;
            }
        }
    }
    
    // If the stack is empty, all brackets were matched correctly
    bool result = (top == -1);
    free(stack);
    return result;
}
