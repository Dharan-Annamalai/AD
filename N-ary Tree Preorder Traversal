#include <stdlib.h>

/**
 * Definition for a Node.
 * struct Node {
 *     int val;
 *     int numChildren;
 *     struct Node** children;
 * };
 */

// Helper function to perform the recursive preorder traversal
void traverse(struct Node* root, int* result, int* returnSize) {
    if (root == NULL) {
        return;
    }
    
    // Visit the root node
    result[(*returnSize)++] = root->val;
    
    // Visit all the children from left to right
    for (int i = 0; i < root->numChildren; i++) {
        traverse(root->children[i], result, returnSize);
    }
}

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* preorder(struct Node* root, int* returnSize) {
    *returnSize = 0;
    
    // Allocate space for the result array. 
    // The constraints state the maximum number of nodes is 10,000.
    int* result = (int*)malloc(10000 * sizeof(int));
    if (result == NULL) {
        return NULL;
    }
    
    traverse(root, result, returnSize);
    
    return result;
}
