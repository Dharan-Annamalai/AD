void sortColors(int* nums, int numsSize) {
    int low = 0;
    int mid = 0;
    int high = numsSize - 1;
    
    while (mid <= high) {
        if (nums[mid] == 0) {
            // Swap nums[mid] and nums[low], then move both pointers forward
            int temp = nums[mid];
            nums[mid] = nums[low];
            nums[low] = temp;
            low++;
            mid++;
        } 
        else if (nums[mid] == 1) {
            // '1' is already in the correct relative position, just move mid forward
            mid++;
        } 
        else { // nums[mid] == 2
            // Swap nums[mid] and nums[high], then move high backward
            // Do NOT increment mid here, because the swapped element from high needs to be evaluated
            int temp = nums[mid];
            nums[mid] = nums[high];
            nums[high] = temp;
            high--;
        }
    }
}
