#include <stdio.h>
#include <stdlib.h>
#include <math.h>

struct triangle
{
	int a;
	int b;
	int c;
};

typedef struct triangle triangle;
// Function to calculate the squared area of a triangle
double get_area_square(triangle t) {
    double p = (t.a + t.b + t.c) / 2.0;
    return p * (p - t.a) * (p - t.b) * (p - t.c);
}

// Comparison function for quicksort
int compare(const void* a, const void* b) {
    triangle* t1 = (triangle*)a;
    triangle* t2 = (triangle*)b;
    
    double area1 = get_area_square(*t1);
    double area2 = get_area_square(*t2);
    
    if (area1 < area2) return -1;
    if (area1 > area2) return 1;
    return 0;
}

// The only function the platform expects you to implement
void sort_by_area(triangle* tr, int n) {
    qsort(tr, n, sizeof(triangle), compare);
}
int main()
{
	int n;
	scanf("%d", &n);
	triangle *tr = malloc(n * sizeof(triangle));
	for (int i = 0; i < n; i++) {
		scanf("%d%d%d", &tr[i].a, &tr[i].b, &tr[i].c);
	}
	sort_by_area(tr, n);
	for (int i = 0; i < n; i++) {
		printf("%d %d %d\n", tr[i].a, tr[i].b, tr[i].c);
	}
	return 0;
}
